        <mxCell id="0egHAsCQhNV49T2AMAIR-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=38;fontColor=#000000;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;b&gt;11B parameter VLM in 3.7 GB for an Arm phone CPU&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;b&gt;Contributions:&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 43px; line-height: 150%;&quot;&gt;&lt;font face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- S3D8 format, co-designed for Arm decoding&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 43px; line-height: 150%;&quot;&gt;&lt;font face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- Multimodal quantization-aware training (QAT) with self-generated data&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 43px; line-height: 150%;&quot;&gt;&lt;font face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- Linux and Android Arm CPU inference implementation for Llama 3.2 11B Vision Instruct&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="528" width="1125.6" x="75.2" y="502" as="geometry" />
        </mxCell>
        <mxCell id="0egHAsCQhNV49T2AMAIR-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=38;fontColor=#000000;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;b&gt;S3D8: ~2.7-bit storage, INT8 compute&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;3D absolute-value vectors with separate sign bits.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- 32 × 3 positive &lt;b&gt;&lt;font color=&quot;#CC0000&quot;&gt;INT8 centroids&lt;/font&gt;&lt;/b&gt; per matrix&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- One &lt;b&gt;&lt;font color=&quot;#0072B2&quot;&gt;bfloat16 scale&lt;/font&gt;&lt;/b&gt; per output channel&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- Shared &lt;b&gt;&lt;font color=&quot;#D55E00&quot;&gt;5-bit centroid index&lt;/font&gt;&lt;/b&gt; per 3 weights&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- &lt;b&gt;&lt;font color=&quot;#009E73&quot;&gt;3 sign bits&lt;/font&gt;&lt;/b&gt; per 3 weights&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="480" width="1530" x="75.2" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="0egHAsCQhNV49T2AMAIR-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=38;fontColor=#000000;" value="&lt;div style=&quot;line-height: 150%;&quot;&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;b&gt;Multimodal QAT&amp;nbsp;fine-tuning without original data&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- Train on&amp;nbsp;&lt;b&gt;KL divergence&lt;/b&gt;&amp;nbsp;between original and quantized model outputs, using a&lt;/font&gt;&lt;span style=&quot;font-size: 43px; font-family: &amp;quot;Graphik Regular&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;font-size: 43px; font-family: &amp;quot;Graphik Regular&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;straight-through estimator&lt;/b&gt;&lt;span style=&quot;font-size: 43px; font-family: &amp;quot;Graphik Regular&amp;quot;; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt; for gradients.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- Self-generate training text from &lt;b&gt;ImageNet images&lt;/b&gt; using the original model.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 43px; line-height: 150%;&quot; face=&quot;Graphik Regular&quot;&gt;&amp;nbsp;- Vary &lt;b&gt;questions, response lengths, output formats &lt;/b&gt;and&lt;b&gt; prompt templates&lt;/b&gt;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt