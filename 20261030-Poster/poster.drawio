        <mxCell id="poster-decoding-speed" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Graphik;fontSize=30;fontColor=#000000;spacing=0;overflow=visible;" value="&lt;div style=&quot;font-family: Graphik; line-height: 1.3;&quot;&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;S3D8 decode: &lt;b style=&quot;&quot;&gt;133 µs (16.5 GB/s)&lt;/b&gt;&lt;br&gt;INT8 copy: &lt;b style=&quot;&quot;&gt;310 µs (21.2 GB/s)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(77, 77, 77), rgb(237, 237, 237));&quot;&gt;(Read bandwidth; vision MLP&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;font-family: Graphik; line-height: 1.3;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(77, 77, 77), rgb(237, 237, 237));&quot;&gt;&lt;font style=&quot;font-size: 36px;&quot;&gt;up-projection; Pixel 8a.)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
