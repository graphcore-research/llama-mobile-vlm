        <mxCell id="poster-decoding-code" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Inconsolata;fontSize=25;fontColor=#000000;spacing=0;overflow=visible;" value="&lt;pre style=&quot;margin: 0px; padding: 0px; font-family: Inconsolata; line-height: 1.3; font-weight: normal; white-space: pre;&quot;&gt;&lt;font style=&quot;font-size: 28px;&quot;&gt;&lt;span style=&quot;color: rgb(119, 119, 136); font-style: italic;&quot;&gt;//  v5: 0x3f mask&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(119, 119, 136); font-style: italic;&quot;&gt;// v26: 16 packed bytes&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;and&lt;/span&gt;  v27.16b, v26.16b, v5.16b&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;ushr&lt;/span&gt; v28.16b, v26.16b, &lt;span style=&quot;color: rgb(119, 119, 136);&quot;&gt;#1&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;and&lt;/span&gt;  v28.16b, v28.16b, v5.16b&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;ushr&lt;/span&gt; v26.16b, v26.16b, &lt;span style=&quot;color: rgb(119, 119, 136);&quot;&gt;#7&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;eor&lt;/span&gt;  v26.16b, v27.16b, v26.16b&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;tbl&lt;/span&gt;  v29.16b, {v1.16b-v4.16b}, v27.16b&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;tbl&lt;/span&gt;  v28.16b, {v16.16b-v19.16b}, v28.16b&lt;br&gt;&lt;span style=&quot;color: rgb(163, 27, 100);&quot;&gt;tbl&lt;/span&gt;  v26.16b, {v20.16b-v23.16b}, v26.16b&lt;/font&gt;&lt;/pre&gt;" vertex="1">
          <mxGeometry height="465" width="587" x="1762" y="1493" as="geometry" />
