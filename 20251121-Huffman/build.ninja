# Rules & variables
builddir = build
cxx = clang++
flags = -std=c++20 -stdlib=libc++ -O3 -fopenmp -Wall -Wextra -Werror -march=native -mcpu=native -fcolor-diagnostics
# cxx = g++
# flags = -std=c++20 -O3 -fopenmp -Wall -Wextra -Werror -march=native -mcpu=native

rule compile
  command = $cxx $flags -o $out $in
rule compile_asm
  command = $cxx $flags -S -o $out $in
rule run
  command = $in $args

# Targets
build $builddir/encodings: compile src/encodings.cpp
build $builddir/encodings.s: compile_asm src/encodings.cpp
build $builddir/benchmarks: compile src/benchmarks.cpp
build $builddir/benchmarks.s: compile_asm src/benchmarks.cpp

build run: run $builddir/encodings
default run
